<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. User-installed CAs are not trusted globally; self-managed CAs are imported per account in the app. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
